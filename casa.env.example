# casa.env.example: os valores da casa que as skills deste plugin leem.
# Copie para ~/.config/biliboss/casa.env (ou aponte BILIBOSS_CASA para outro arquivo) e preencha.
# Formato CHAVE=valor, lido pelo shell: use $HOME em vez de ~. Esse arquivo nunca entra no git.

# --- Linear ---
# O slug do workspace (a parte de linear.app/<workspace>).
CASA_LINEAR_WORKSPACE=meu-workspace
# A chave do time nos identificadores dos cartões (a parte antes do número, como em ABC-123).
CASA_LINEAR_TIME_CHAVE=ABC
# O id (UUID) do time.
CASA_LINEAR_TIME_ID=00000000-0000-0000-0000-000000000000
# O id (UUID) do dono da casa (o responsável dos cartões).
CASA_LINEAR_DONO_ID=00000000-0000-0000-0000-000000000000
# O id (UUID) do app do Bili no Linear (o delegado dos cartões de agente).
CASA_LINEAR_APP_BILI_ID=00000000-0000-0000-0000-000000000000
# Os ids (UUID) dos estados dos cartões.
CASA_LINEAR_ESTADO_TODO_ID=00000000-0000-0000-0000-000000000000
CASA_LINEAR_ESTADO_DOING_ID=00000000-0000-0000-0000-000000000000
CASA_LINEAR_ESTADO_DONE_ID=00000000-0000-0000-0000-000000000000
# O id (UUID) do doc do time com as regras dos agentes.
CASA_LINEAR_DOC_AGENTS_ID=00000000-0000-0000-0000-000000000000
# Os ids (UUID) dos status de projeto, do backlog ao concluído.
CASA_LINEAR_STATUS_IDEIA_ID=00000000-0000-0000-0000-000000000000
CASA_LINEAR_STATUS_DECIDIR_ID=00000000-0000-0000-0000-000000000000
CASA_LINEAR_STATUS_CONSTRUINDO_ID=00000000-0000-0000-0000-000000000000
CASA_LINEAR_STATUS_ESPERA_PESSOA_ID=00000000-0000-0000-0000-000000000000
CASA_LINEAR_STATUS_NO_AR_ID=00000000-0000-0000-0000-000000000000
CASA_LINEAR_STATUS_RESULTADO_VISTO_ID=00000000-0000-0000-0000-000000000000

# --- O Bili e a VPS ---
# A URL do perfil do Bili no Linear (a menção que abre a sessão dele).
CASA_BILI_PERFIL_URL=https://linear.app/meu-workspace/profiles/bili
# O host da VPS, como o ssh o conhece (um alias do ~/.ssh/config ou um nome).
CASA_VPS_HOST=minha-vps
# O usuário do Bili na VPS.
CASA_VPS_USUARIO_BILI=usuario-do-bili
# Os outros usuários da VPS que têm um pi próprio, separados por espaço.
CASA_VPS_USUARIOS_PI="usuario-a usuario-b"
# A URL do monitor HTTP do NATS (host e porta), para conferir os streams.
CASA_NATS_MONITOR_URL=http://host-do-nats:8222
# O repo (dono/nome no GitHub) que provisiona a VPS.
CASA_REPO_VPS=dono/repo-da-vps

# --- Esta máquina ---
# O repo principal da casa (notas, wiki e AGENTS.md); é a pasta onde as sessões de agente abrem.
CASA_REPO_PRINCIPAL=$HOME/repo-principal
# A conta principal do Claude: o nome curto (usado como argumento do pi-claude.sh) e a pasta do CLAUDE_CONFIG_DIR.
CASA_CONTA_PRINCIPAL_NOME=principal
CASA_CONTA_PRINCIPAL_DIR=$HOME/.claude-principal
# A conta secundária do Claude: o nome curto e a pasta do CLAUDE_CONFIG_DIR.
CASA_CONTA_SECUNDARIA_NOME=secundaria
CASA_CONTA_SECUNDARIA_DIR=$HOME/.claude
