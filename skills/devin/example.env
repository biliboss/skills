# Copie para .env ao lado do SKILL.md. Todas as chaves são opcionais; os valores abaixo são os padrões.
# Binário do Devin CLI.
DEVIN_BIN=devin
# Onde ficam pedido, resposta, log e worktree de cada rodada. Fora de qualquer repositório.
DEVIN_RUNS_DIR=/Users/you/.local/share/devin-runs
# Modelo padrão. Um modelo pago consome saldo.
DEVIN_SKILL_MODEL=swe-2-max
# Modo de permissão padrão: auto, accept-edits ou smart. O dangerous é recusado.
DEVIN_SKILL_MODE=accept-edits
