#!/bin/sh
# git-credential-bili-mac: credential helper do git nas sessões de agente do Mac (Claude Code, pi, subagentes).
#   Entrega o token de instalação (1 h) do app Bili Clone da conta dona do repositório, buscado na hora na VPS
#   (ssh com a chave dedicada no usuário token-mac, que só sabe entregar o token) e nunca gravado em disco.
#   Só responde a get, só para https://github.com, só para as contas da lista (biliboss, viacorretor, mktvirtual).
#   Precisa de credential.useHttpPath (o git manda o dono/repo): o bili-git-agente configura tudo.
# Uso (gitconfig): helper = <CASA_BIN>/git-credential-bili-mac   (depois de um helper vazio, que zera os outros)
set -u
EU=git-credential-bili-mac
[ "${1:-}" = get ] || exit 0   # store e erase: nada a guardar, nada a apagar
protocolo=""; host=""; caminho=""
while IFS='=' read -r k v; do
  [ -z "$k" ] && break
  case "$k" in protocol) protocolo=$v ;; host) host=$v ;; path) caminho=$v ;; esac
done
# outro host (ou github.com com porta, http, um github.com.algo): não é com este helper
[ "$protocolo" = https ] && [ "$host" = github.com ] || exit 0

CASA="${BILIBOSS_CASA:-$HOME/.config/biliboss/casa.env}"
[ -f "$CASA" ] || { echo "$EU: falta o arquivo $CASA; copie o casa.env.example (raiz do repo biliboss/skills) para lá e preencha" >&2; exit 1; }
. "$CASA"
: "${CASA_TOKEN_HOST:?git-credential-bili-mac: falta CASA_TOKEN_HOST em $CASA (veja o casa.env.example)}"
: "${CASA_TOKEN_USUARIO:?git-credential-bili-mac: falta CASA_TOKEN_USUARIO em $CASA (veja o casa.env.example)}"
: "${CASA_TOKEN_CHAVE:?git-credential-bili-mac: falta CASA_TOKEN_CHAVE em $CASA (veja o casa.env.example)}"

dono=$(printf '%s' "$caminho" | cut -d/ -f1 | tr 'A-Z' 'a-z')
case "$dono" in
  biliboss|viacorretor|mktvirtual) ;;
  "") echo "$EU: o git não mandou o caminho do repo (falta credential.useHttpPath true; rode o bili-git-agente)" >&2; exit 1 ;;
  *) echo "$EU: sem token do bot para '$dono' (só biliboss, viacorretor e mktvirtual); nada de cair na conta do Gabriel" >&2; exit 0 ;;
esac
[ -r "$CASA_TOKEN_CHAVE" ] || { echo "$EU: não acho a chave $CASA_TOKEN_CHAVE (CASA_TOKEN_CHAVE); gere com ssh-keygen -t ed25519 -f $CASA_TOKEN_CHAVE" >&2; exit 1; }

# o token fica só nesta variável; o stderr do ssh passa direto, para o erro ser legível
busca() {
  ssh -n -T -i "$CASA_TOKEN_CHAVE" -o IdentitiesOnly=yes -o BatchMode=yes -o ConnectTimeout=10 \
    "$CASA_TOKEN_USUARIO@$CASA_TOKEN_HOST" "$dono"
}
token=$(busca) || token=""
# o bili-token troca o arquivo por rename e a ACL volta uns segundos depois: uma segunda tentativa cobre a janela
case "$token" in gh?_*) ;; *) sleep 2; token=$(busca) || token="" ;; esac
case "$token" in
  *[!A-Za-z0-9_]*|"") echo "$EU: a VPS não entregou um token para '$dono' ($CASA_TOKEN_USUARIO@$CASA_TOKEN_HOST); confira com: bili-git-agente conferir" >&2; exit 1 ;;
  gh?_*) ;;
  *) echo "$EU: a VPS entregou algo que não parece um token do GitHub para '$dono'" >&2; exit 1 ;;
esac
printf 'username=x-access-token\npassword=%s\n' "$token"
