# Registry of bots (default: ~/agents/bots.json). Each bot needs "id" and "folder".
CANVAS_BOTS=/Users/you/agents/bots.json
# Local server port for `canvas serve` and the mod (127.0.0.1 only).
CANVAS_PORT=47836
# Herdr home that `canvas open` talks to (passed as HERDR_APP_HOME).
CANVAS_HERDR_HOME=/Users/you/.config/herdr-bili
# `canvas install` requires HERDR_APP_HOME (not HERDR_HOME); there is no default.
