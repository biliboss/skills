#!/usr/bin/env python3
"""List the companion bots; live is true, false, or null when Herdr cannot be inspected."""
import argparse
from pathlib import Path
import subprocess
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / 'bili-agents' / 'scripts'))
import bots  # noqa: E402


def live(bot):
    try:
        return bots.is_live(bot)
    except (OSError, KeyError, ValueError, RuntimeError, subprocess.SubprocessError):
        return None


def roster():
    return {'bots': [{'id': bot['id'], 'name': bot['name'], 'folder': bot['folder'],
                      'principal': bot.get('principal') is True, 'live': live(bot)}
                     for bot in bots.registry()]}


def main():
    argparse.ArgumentParser(description=__doc__).parse_args()
    return bots.verb(roster)


if __name__ == '__main__':
    sys.exit(main())
