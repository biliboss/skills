# Optional convenience for humans and agents; not part of the Python API.
# Run from the skill root with: just --justfile scripts/justfile list

python := "python3"
script := justfile_directory() + "/app_tensions.py"

list:
    {{python}} -c 'import importlib.util,json; s=importlib.util.spec_from_file_location("tensions", "{{script}}"); m=importlib.util.module_from_spec(s); s.loader.exec_module(m); print(json.dumps(m.Tensions().read(), ensure_ascii=False, indent=2))'

read id:
    {{python}} -c 'import importlib.util,json,sys; s=importlib.util.spec_from_file_location("tensions", sys.argv[1]); m=importlib.util.module_from_spec(s); s.loader.exec_module(m); print(json.dumps(m.Tensions().read({"id":sys.argv[2]}), ensure_ascii=False, indent=2))' '{{script}}' '{{id}}'

history id:
    {{python}} -c 'import importlib.util,json,sys; s=importlib.util.spec_from_file_location("tensions", sys.argv[1]); m=importlib.util.module_from_spec(s); s.loader.exec_module(m); print(json.dumps(m.Tensions().read({"id":sys.argv[2],"history":True}), ensure_ascii=False, indent=2))' '{{script}}' '{{id}}'

# The event value must be provided as a JSON FILE, not shell-embedded JSON.
emit event json_file tension_id="":
    {{python}} -c 'import importlib.util,json,sys,pathlib; s=importlib.util.spec_from_file_location("tensions", sys.argv[1]); m=importlib.util.module_from_spec(s); s.loader.exec_module(m); print(json.dumps(m.Tensions().emit(sys.argv[2],json.loads(pathlib.Path(sys.argv[3]).read_text()),sys.argv[4] or None),ensure_ascii=False,indent=2))' '{{script}}' '{{event}}' '{{json_file}}' '{{tension_id}}'
