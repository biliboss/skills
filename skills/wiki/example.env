# Copy to .env (same folder) and edit. A variable already set in the
# environment wins over the value here.

# Folder that holds the central wiki checkout: one subfolder per project.
WIKI_HOME=$HOME/wiki

# GitHub repo (owner/name) of the central wiki; builds the default remote.
WIKI_REPO=biliboss/wiki

# URL cloned when WIKI_HOME has no checkout yet (default shown).
WIKI_REMOTE=git@github.com:$WIKI_REPO.git
